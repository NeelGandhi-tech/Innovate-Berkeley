<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Past partners', path: '/partners', description: 'Past speakers, firms, sponsors and startups at Innovate@Berkeley, including Sequoia Capital, Accel, General Catalyst and Thrive Capital.' }) %>
</head>
<body>
    <%- include('partials/site-header', { current: 'partners' }) %>
<%
  const firms = partners.filter(p => p.kind !== 'startup');
  const pastStartups = partners.filter(p => p.kind === 'startup' && p.year !== 2027);
-%>
    <main id="main">
        <section class="page-intro page-intro--text-only">
            <div class="wrap grid">
                <div class="page-intro__text">
                    <p class="kicker">Past partners</p>
                    <h1>Speakers, firms and startups</h1>
                    <p class="page-intro__lede">We're grateful for the support of our partners and the startups that have made Innovate@Berkeley possible over the years.</p>
                </div>
            </div>
        </section>

        <!-- Past speakers -->
        <section class="section" aria-labelledby="speakers-title">
            <div class="wrap grid">
                <header class="section__head">
                    <p class="kicker"><%= speakers.length %> people</p>
                    <h2 id="speakers-title">Past speakers and panelists</h2>
                </header>
                <div class="section__content">
                    <ul class="people">
    <% speakers.forEach(s => { -%>
                        <li class="person">
                            <img src="<%= s.photo %>" width="320" height="320" alt="" loading="lazy" decoding="async">
                            <p class="person__name"><%= s.name %></p>
                            <p class="person__firm"><%= s.firm %></p>
                        </li>
    <% }) -%>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Logos -->
        <section class="section" aria-labelledby="firms-title">
            <div class="wrap grid">
                <header class="section__head">
                    <p class="kicker"><%= firms.length %> organisations</p>
                    <h2 id="firms-title">Firms and sponsors</h2>
                </header>
                <div class="section__content">
                    <ul class="logo-grid">
    <% firms.forEach(item => { -%>
                        <li><%- include('partials/logo', { item, hidden: false }) %></li>
    <% }) -%>
                    </ul>
                </div>
            </div>
        </section>

        <section class="section" aria-labelledby="startups-title">
            <div class="wrap grid">
                <header class="section__head">
                    <p class="kicker"><%= pastStartups.length %> companies</p>
                    <h2 id="startups-title">Past startups</h2>
                </header>
                <div class="section__content">
                    <ul class="logo-grid">
    <% pastStartups.forEach(item => { -%>
                        <li><%- include('partials/logo', { item, hidden: false }) %></li>
    <% }) -%>
                    </ul>
                    <p class="section__more">This year's startups are on the <a href="/">home page</a>.</p>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/site-footer') %>
</body>
</html>
