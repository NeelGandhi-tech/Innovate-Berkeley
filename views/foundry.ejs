<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Foundry', path: '/foundry', description: 'Foundry @ Berkeley is a founder and investor network for investors without a full-time sourcing presence in Silicon Valley. An AEZ initiative from the team behind Innovate @ Berkeley.' }) %>
    <link rel="stylesheet" href="/css/foundry.css">
</head>
<body>
    <%- include('partials/site-header', { current: 'foundry' }) %>

    <main id="main" class="foundry">

        <!-- Hero -->
        <section class="foundry-hero" aria-labelledby="foundry-title">
            <div class="wrap foundry-hero__grid">
                <div class="foundry-hero__text">
                    <img class="foundry-logo" src="/images/foundry/foundry-wordmark.png" alt="Foundry @ Berkeley" width="820" height="233">
                    <h1 id="foundry-title">A founder and investor network</h1>
                    <p class="foundry-hero__body">An <a href="<%= site.organizerUrl %>">AEZ</a> initiative, built by the team behind Innovate&nbsp;@&nbsp;Berkeley. It gives investors a way into Silicon Valley's founders without a full-time sourcing presence here.</p>
                    <div class="foundry-actions">
                        <a class="button button--primary" href="<%= site.foundryContactUrl %>">Get in touch</a>
                    </div>
                </div>
                <figure class="foundry-hero__photo">
                    <img src="/images/photos/fa25-044-960.jpg"
                         srcset="/images/photos/fa25-044-960.jpg 960w, /images/photos/fa25-044-1920.jpg 1920w"
                         sizes="(min-width: 900px) 40vw, 100vw"
                         width="1920" height="1280" fetchpriority="high" decoding="async"
                         alt="Two speakers in conversation on stage at Innovate Fall 2025, one holding a microphone">
                    <figcaption>Innovate @ Berkeley, Fall 2025</figcaption>
                </figure>
            </div>
        </section>

        <!-- Who it's for -->
        <section class="foundry-section" aria-labelledby="who-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>01</span> Who it's for</p>
                    <h2 id="who-title">Investors outside Silicon Valley</h2>
                </header>
                <ul class="foundry-list">
                    <li>Seed and Series A funds outside San Francisco</li>
                    <li>International investors and LPs</li>
                    <li>Corporate and CVC innovation teams</li>
                </ul>
            </div>
        </section>

        <!-- What members get -->
        <section class="foundry-section foundry-section--tint" aria-labelledby="get-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>02</span> Membership</p>
                    <h2 id="get-title">What members get</h2>
                </header>
                <dl class="foundry-model">
                    <div>
                        <dt>Two briefings a month</dt>
                        <dd>Tailored Silicon Valley briefings.</dd>
                    </div>
                    <div>
                        <dt>A monthly scouting call</dt>
                        <dd>A regular check-in on what we're seeing.</dd>
                    </div>
                    <div>
                        <dt>A prioritized founder list</dt>
                        <dd>Matched to your thesis.</dd>
                    </div>
                    <div>
                        <dt>Introductions</dt>
                        <dd>Opt-in, where there is mutual interest.</dd>
                    </div>
                </dl>
            </div>
        </section>

        <!-- Coverage -->
        <section class="foundry-section" aria-labelledby="coverage-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>03</span> Coverage</p>
                    <h2 id="coverage-title">Starting at Berkeley</h2>
                </header>
                <p class="foundry-text">We start with Berkeley's student builders, labs and alumni, then extend across San Francisco, the Peninsula and the South Bay.</p>
            </div>
        </section>

        <!-- Pilot -->
        <section class="foundry-section foundry-section--tint" aria-labelledby="pilot-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>04</span> Getting started</p>
                    <h2 id="pilot-title">Start with a 90-day pilot</h2>
                </header>
                <p class="foundry-text">Every engagement begins as a 90-day pilot.</p>
            </div>
        </section>

        <!-- Track record -->
        <section class="foundry-section" aria-labelledby="record-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>05</span> Track record</p>
                    <h2 id="record-title">Built by the Innovate @ Berkeley team</h2>
                </header>
                <div>
                    <dl class="foundry-stats">
                        <div><dt>500+</dt><dd>attendees at past events</dd></div>
                        <div><dt>25+</dt><dd>startups at past events</dd></div>
                    </dl>
                    <p class="foundry-text">Past Innovate speakers include Miles Grimshaw (Thrive Capital), Andrew Milich (Cursor), Alice Bentinck (Entrepreneurs First) and Dhruv Parthasarathy (Commure). <a href="/partners#speakers">All past speakers</a></p>
                </div>
            </div>
            <figure class="foundry-band">
                <img src="/images/photos/fa25-120-960.jpg"
                     srcset="/images/photos/fa25-120-960.jpg 960w, /images/photos/fa25-120-1920.jpg 1920w"
                     sizes="(min-width: 900px) 960px, 100vw"
                     width="1920" height="1280" loading="lazy" decoding="async"
                     alt="Attendees talking in a hallway at Innovate Fall 2025">
                <figcaption>Innovate @ Berkeley, Fall 2025</figcaption>
            </figure>
        </section>

        <!-- Contact -->
        <section class="foundry-cta" id="partner" aria-labelledby="partner-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <img class="foundry-cta__mark" src="/images/foundry/foundry-mark-white.png" alt="" width="226" height="219">
                    <h2 id="partner-title">Talk to us</h2>
                </header>
                <div class="foundry-cta__body">
                    <p>Tell us where you invest and we'll set up a call.</p>
                    <a class="button button--on-dark" href="<%= site.foundryContactUrl %>">Get in touch</a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/site-footer') %>
</body>
</html>
