<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Foundry', path: '/foundry', description: 'Foundry builds strategic recruiting partnerships between leading venture capital firms and the University of California, Berkeley, through targeted talent sourcing and curated introductions.' }) %>
    <link rel="stylesheet" href="/css/foundry.css">
</head>
<body>
    <%- include('partials/site-header', { current: 'foundry' }) %>

    <main id="main" class="foundry">

        <!-- A: Hero -->
        <section class="foundry-hero" aria-labelledby="foundry-title">
            <div class="wrap foundry-hero__grid">
                <div class="foundry-hero__text">
                    <p class="foundry-wordmark">Foundry <span>An Innovate @ Berkeley initiative</span></p>
                    <h1 id="foundry-title">Connecting Exceptional Talent with Exceptional Capital.</h1>
                    <p class="foundry-hero__body">Foundry builds strategic recruiting partnerships between leading venture capital firms and the University of California, Berkeley. Through targeted talent sourcing and curated introductions, we connect investment firms with exceptional technical, entrepreneurial, and business talent emerging from one of the world's leading innovation ecosystems.</p>
                    <div class="foundry-actions">
                        <a class="button button--on-dark" href="#partner">Partner With Foundry</a>
                        <a class="button button--outline-on-dark" href="#opportunity">Explore Our Network</a>
                    </div>
                </div>

                <figure class="foundry-hero__visual">
                    <svg viewBox="-60 0 600 410" role="img" aria-labelledby="hero-graphic-title">
                        <title id="hero-graphic-title">Diagram: Berkeley at the centre, linking talent in engineering, computer science, AI, business, finance and economics with target financial centres in New York, Boston, London, Paris and Berlin.</title>
                        <!-- architectural guides -->
                        <g class="fg-guide">
                            <line x1="-60" y1="240" x2="540" y2="240"/>
                            <line x1="240" y1="0" x2="240" y2="410"/>
                            <circle cx="240" cy="240" r="120"/>
                            <circle cx="240" cy="240" r="200"/>
                        </g>
                        <!-- links -->
                        <g class="fg-link fg-link--capital">
                            <line x1="240" y1="240" x2="433.2" y2="188.2"/>
                            <line x1="240" y1="240" x2="381.4" y2="98.6"/>
                            <line x1="240" y1="240" x2="240" y2="40"/>
                            <line x1="240" y1="240" x2="98.6" y2="98.6"/>
                            <line x1="240" y1="240" x2="46.8" y2="188.2"/>
                        </g>
                        <g class="fg-link">
                            <line x1="240" y1="240" x2="124.1" y2="271.1"/>
                            <line x1="240" y1="240" x2="155.1" y2="324.9"/>
                            <line x1="240" y1="240" x2="208.9" y2="355.9"/>
                            <line x1="240" y1="240" x2="271.1" y2="355.9"/>
                            <line x1="240" y1="240" x2="324.9" y2="324.9"/>
                            <line x1="240" y1="240" x2="355.9" y2="271.1"/>
                        </g>
                        <!-- capital: target financial centres -->
                        <g class="fg-node fg-node--capital">
                            <circle cx="433.2" cy="188.2" r="6"/>
                            <circle cx="381.4" cy="98.6" r="6"/>
                            <circle cx="240" cy="40" r="6"/>
                            <circle cx="98.6" cy="98.6" r="6"/>
                            <circle cx="46.8" cy="188.2" r="6"/>
                        </g>
                        <g class="fg-label fg-label--capital">
                            <text x="448" y="183">New York</text>
                            <text x="395" y="86">Boston</text>
                            <text x="240" y="22" text-anchor="middle">London</text>
                            <text x="85" y="86" text-anchor="end">Paris</text>
                            <text x="32" y="183" text-anchor="end">Berlin</text>
                        </g>
                        <!-- talent: disciplines -->
                        <g class="fg-node">
                            <circle cx="124.1" cy="271.1" r="4"/>
                            <circle cx="155.1" cy="324.9" r="4"/>
                            <circle cx="208.9" cy="355.9" r="4"/>
                            <circle cx="271.1" cy="355.9" r="4"/>
                            <circle cx="324.9" cy="324.9" r="4"/>
                            <circle cx="355.9" cy="271.1" r="4"/>
                        </g>
                        <g class="fg-label">
                            <text x="108" y="283" text-anchor="end">Engineering</text>
                            <text x="141" y="345" text-anchor="end">Computer science</text>
                            <text x="205" y="384" text-anchor="middle">AI</text>
                            <text x="276" y="384" text-anchor="middle">Business</text>
                            <text x="339" y="345">Finance</text>
                            <text x="372" y="283">Economics</text>
                        </g>
                        <!-- hub -->
                        <circle class="fg-hub-ring" cx="240" cy="240" r="18"/>
                        <circle class="fg-hub" cx="240" cy="240" r="8"/>
                        <text class="fg-label fg-label--hub" x="262" y="232">Berkeley</text>
                    </svg>
                    <figcaption class="foundry-legend">
                        <span><i class="foundry-dot foundry-dot--capital" aria-hidden="true"></i>Target financial centres</span>
                        <span><i class="foundry-dot" aria-hidden="true"></i>Berkeley talent</span>
                    </figcaption>
                </figure>
            </div>
        </section>

        <!-- B: The opportunity -->
        <section class="foundry-section" id="opportunity" aria-labelledby="opportunity-title">
            <div class="wrap">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>01</span> The opportunity</p>
                    <h2 id="opportunity-title">An Unmatched Talent Ecosystem.</h2>
                </header>
                <div class="foundry-pillars">
                    <article class="foundry-pillar">
                        <h3>Technical Excellence</h3>
                        <p>Access to exceptional engineering, computer science, AI, and other technical talent emerging from UC Berkeley.</p>
                    </article>
                    <article class="foundry-pillar">
                        <h3>Entrepreneurial Mindset</h3>
                        <p>Connect with students who are building companies, exploring new technologies, and developing the next generation of innovative businesses.</p>
                    </article>
                    <article class="foundry-pillar">
                        <h3>Cross-Disciplinary Talent</h3>
                        <p>Identify candidates across business, finance, economics, engineering, and other disciplines who can contribute to venture capital firms and their portfolio companies.</p>
                    </article>
                </div>
            </div>
        </section>

        <!-- C: How Foundry works -->
        <section class="foundry-section foundry-section--tint" id="process" aria-labelledby="process-title">
            <div class="wrap">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>02</span> How Foundry works</p>
                    <h2 id="process-title">A More Direct Path to Exceptional Talent.</h2>
                </header>
                <ol class="foundry-steps">
                    <li class="foundry-step">
                        <span class="foundry-step__num" aria-hidden="true">01</span>
                        <h3>Identify</h3>
                        <p>Establish relationships with venture capital firms and understand their hiring needs, investment focus, and desired candidate profiles.</p>
                    </li>
                    <li class="foundry-step">
                        <span class="foundry-step__num" aria-hidden="true">02</span>
                        <h3>Source</h3>
                        <p>Leverage Innovate Berkeley's network to identify qualified candidates with relevant technical, entrepreneurial, and professional experience.</p>
                    </li>
                    <li class="foundry-step">
                        <span class="foundry-step__num" aria-hidden="true">03</span>
                        <h3>Connect</h3>
                        <p>Facilitate curated introductions between firms and high-potential candidates, helping establish meaningful professional relationships and recruiting opportunities.</p>
                    </li>
                </ol>
            </div>
        </section>

        <!-- D: Partnership model -->
        <section class="foundry-section" id="model" aria-labelledby="model-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>03</span> Our partnership model</p>
                    <h2 id="model-title">Built Around Strategic Partnerships.</h2>
                </header>
                <div>
                    <dl class="foundry-model">
                        <div>
                            <dt>Dedicated Sourcing</dt>
                            <dd>Understand each firm's hiring objectives and source talent aligned with its specific needs.</dd>
                        </div>
                        <div>
                            <dt>Curated Introductions</dt>
                            <dd>Connect firms with carefully identified candidates rather than relying on broad, untargeted applicant pools.</dd>
                        </div>
                        <div>
                            <dt>Long-Term Relationships</dt>
                            <dd>Build sustained partnerships with investment firms to support recurring talent needs and create lasting connections with Berkeley's talent ecosystem.</dd>
                        </div>
                    </dl>
                    <p class="foundry-note">Foundry aims to establish paid talent sourcing and recruiting partnerships with participating firms.</p>
                </div>
            </div>
        </section>

        <!-- E: Geographic focus -->
        <section class="foundry-section foundry-section--tint" id="regions" aria-labelledby="regions-title">
            <div class="wrap">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>04</span> Geographic focus</p>
                    <h2 id="regions-title">Building Connections Across Global Venture Capital.</h2>
                </header>
                <figure class="foundry-map" tabindex="0" aria-label="Map of target regions. On small screens, scroll sideways to see Europe.">
                    <svg viewBox="0 0 960 300" role="img" aria-labelledby="map-title">
                        <title id="map-title">Map: Berkeley as the central hub, with connections toward target regions on the US East Coast (New York, Boston) and in Europe (London, Paris, Berlin). Target regions only; not confirmed partnerships or offices.</title>
                        <!-- graticule: every 10 degrees, equirectangular -->
                        <g class="fm-grid">
                            <line x1="30" y1="0" x2="30" y2="300"/><line x1="90" y1="0" x2="90" y2="300"/><line x1="150" y1="0" x2="150" y2="300"/><line x1="210" y1="0" x2="210" y2="300"/><line x1="270" y1="0" x2="270" y2="300"/><line x1="330" y1="0" x2="330" y2="300"/><line x1="390" y1="0" x2="390" y2="300"/><line x1="450" y1="0" x2="450" y2="300"/><line x1="510" y1="0" x2="510" y2="300"/><line x1="570" y1="0" x2="570" y2="300"/><line x1="630" y1="0" x2="630" y2="300"/><line x1="690" y1="0" x2="690" y2="300"/><line x1="750" y1="0" x2="750" y2="300"/><line x1="810" y1="0" x2="810" y2="300"/><line x1="870" y1="0" x2="870" y2="300"/><line x1="930" y1="0" x2="930" y2="300"/>
                            <line x1="0" y1="18" x2="960" y2="18"/><line x1="0" y1="108" x2="960" y2="108"/><line x1="0" y1="198" x2="960" y2="198"/><line x1="0" y1="288" x2="960" y2="288"/>
                        </g>
                        <g class="fm-grid-label">
                            <text x="4" y="14">60°N</text><text x="4" y="104">50°N</text><text x="4" y="194">40°N</text>
                        </g>
                        <!-- target region frames -->
                        <rect class="fm-region" x="340" y="150" width="76" height="70"/>
                        <text class="fm-region-label" x="340" y="142">Target region · East Coast US</text>
                        <rect class="fm-region" x="786" y="62" width="122" height="80"/>
                        <text class="fm-region-label" x="786" y="54">Target region · Europe</text>
                        <!-- connections from the hub -->
                        <g class="fm-arc">
                            <path d="M76.4 217.2 Q221 110 366 191.6"/>
                            <path d="M76.4 217.2 Q230 92 383.6 176.8"/>
                            <path d="M76.4 217.2 Q442 -40 809.2 94.4"/>
                            <path d="M76.4 217.2 Q450 -20 824.1 118.3"/>
                            <path d="M76.4 217.2 Q480 -60 890.4 85.3"/>
                        </g>
                        <!-- cities -->
                        <g class="fm-city">
                            <circle cx="366" cy="191.6" r="5"/>
                            <circle cx="383.6" cy="176.8" r="5"/>
                            <circle cx="809.2" cy="94.4" r="5"/>
                            <circle cx="824.1" cy="118.3" r="5"/>
                            <circle cx="890.4" cy="85.3" r="5"/>
                        </g>
                        <g class="fm-label">
                            <text x="366" y="212" text-anchor="middle">New York</text>
                            <text x="392" y="172">Boston</text>
                            <text x="800" y="90" text-anchor="end">London</text>
                            <text x="824" y="137" text-anchor="middle">Paris</text>
                            <text x="898" y="80">Berlin</text>
                        </g>
                        <!-- hub -->
                        <circle class="fm-hub-ring" cx="76.4" cy="217.2" r="16"/>
                        <circle class="fm-hub" cx="76.4" cy="217.2" r="7"/>
                        <text class="fm-label fm-label--hub" x="76.4" y="252" text-anchor="middle">Berkeley</text>
                        <text class="fm-sublabel" x="76.4" y="270" text-anchor="middle">Hub</text>
                    </svg>
                </figure>
                <p class="foundry-map__hint" aria-hidden="true">Scroll the map sideways to see Europe.</p>
                <div class="foundry-regions">
                    <div>
                        <h3 class="label">Hub</h3>
                        <p>Berkeley, California</p>
                    </div>
                    <div>
                        <h3 class="label">Target region: East Coast US</h3>
                        <p>New York, Boston</p>
                    </div>
                    <div>
                        <h3 class="label">Target region: Europe</h3>
                        <p>London, Paris, Berlin</p>
                    </div>
                </div>
                <p class="foundry-note">Target regions describe where Foundry intends to build relationships. They are not confirmed partnerships or offices.</p>
            </div>
        </section>

        <!-- F: Partner with Foundry -->
        <section class="foundry-cta" id="partner" aria-labelledby="partner-title">
            <div class="wrap foundry-split">
                <header class="foundry-head">
                    <p class="foundry-kicker"><span>05</span> Partner with Foundry</p>
                    <h2 id="partner-title">Looking to Access Berkeley's Next Generation of Talent?</h2>
                </header>
                <div class="foundry-cta__body">
                    <p>Whether you're an established venture capital firm or an emerging investment platform, Foundry provides a direct connection to the technical, entrepreneurial, and business talent emerging from UC Berkeley.</p>
                    <a class="button button--on-dark" href="<%= site.foundryContactUrl %>">Start a Partnership Conversation</a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/site-footer') %>
</body>
</html>
