<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Gallery', path: '/gallery', ogImage: '/images/photos/og-fa25-254.jpg', description: 'Photos from Innovate@Berkeley in Fall 2024 and Fall 2025.' }) %>
</head>
<body>
    <%- include('partials/site-header', { current: 'gallery' }) %>

    <main id="main">
        <section class="page-intro page-intro--text-only">
            <div class="wrap grid">
                <div class="page-intro__text">
                    <p class="kicker">Gallery</p>
                    <h1>Past events</h1>
                    <p class="page-intro__lede">Moments from past Innovate@Berkeley events.</p>
                </div>
            </div>
        </section>
<%#
  Each year is a continuously scrolling strip, built like the home page's partner row:
  photos are rendered twice for a seamless loop (second copy aria-hidden, empty alt),
  photo-strip.js makes it a real scroll container that glides on its own and can be scrolled by hand;
  it pauses on hover, focus and while being scrolled, and never moves on its own with reduced motion.
  Photos are not lazy-loaded: Chrome does not lazy-load images that move into view through a CSS animation,
  so they would scroll past blank. The duplicate copy reuses the same cached files.
-%>
<% gallery.forEach((group, g) => { const id = 'year-' + group.year.toLowerCase().replace(/\s+/g, '-'); -%>

        <section class="section gallery-year" aria-labelledby="<%= id %>">
            <div class="wrap grid">
                <header class="section__head">
                    <h2 id="<%= id %>"><%= group.year %></h2>
                </header>
            </div>
            <div class="marquee marquee--photos<%= g % 2 ? ' marquee--reverse' : '' %>" data-speed="40" tabindex="0" role="region" aria-labelledby="<%= id %>">
                <ul class="marquee__track">
<% [false, true].forEach(hidden => { group.photos.forEach((photo, i) => { -%>
                    <li<%- hidden ? ' aria-hidden="true"' : '' %>><img src="/images/photos/gallery/<%= photo.slug %>-800.jpg" width="<%= photo.width %>" height="<%= photo.height %>" alt="<%= hidden ? '' : photo.alt %>" draggable="false" decoding="async"></li>
<% }) }) -%>
                </ul>
            </div>
        </section>
<% }) -%>
    </main>

    <%- include('partials/site-footer') %>
    <script src="/js/photo-strip.js"></script>
</body>
</html>
