<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Gallery', path: '/gallery', ogImage: '/images/photos/og-fa25-254.jpg', description: 'Photos from past Innovate@Berkeley events, from 2021 to Fall 2025.' }) %>
</head>
<body>
    <%- include('partials/site-header', { current: 'gallery' }) %>

    <main id="main">
        <section class="page-intro page-intro--text-only">
            <div class="wrap grid">
                <div class="page-intro__text">
                    <p class="kicker">Gallery</p>
                    <h1>Past events</h1>
                    <p class="page-intro__lede">Moments from past Innovate@Berkeley events.</p>
                </div>
            </div>
        </section>
<% let index = 0; gallery.forEach(group => { const id = 'year-' + group.year.toLowerCase().replace(/\s+/g, '-'); -%>

        <section class="section gallery-year" aria-labelledby="<%= id %>">
            <div class="wrap grid">
                <header class="section__head">
                    <h2 id="<%= id %>"><%= group.year %></h2>
                </header>
                <div class="section__content">
                    <ul class="gallery-grid">
    <% group.photos.forEach(photo => { const eager = index++ < 3; -%>
                        <li>
                            <img src="<%= photo.src %>" width="<%= photo.width %>" height="<%= photo.height %>" alt="<%= photo.alt %>"
                                 <%- eager ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
                        </li>
    <% }) -%>
                    </ul>
                </div>
            </div>
        </section>
<% }) -%>
    </main>

    <%- include('partials/site-footer') %>
</body>
</html>
