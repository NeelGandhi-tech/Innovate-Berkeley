<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gallery - Innovate @ Berkeley</title>
    <link rel="icon" type="image/jpeg" href="/images/small_logo.jpg">
    <link rel="icon" type="image/png" href="/images/small_logo.png">
    <link rel="apple-touch-icon" href="/images/small_logo.png">
    <link rel="shortcut icon" href="/images/small_logo.jpg">
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
    <style>
        .gallery-hero {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            padding: 80px 0 60px;
            text-align: center;
            color: white;
        }
        
        .gallery-hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }
        
        .gallery-hero p {
            font-size: 1.2rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .gallery-section {
            padding: 40px 0;
            background: #f8f9fa;
        }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 1rem;
        }
        
        .gallery-item {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: #e9ecef; /* grey placeholder while a photo loads */
            height: 250px;
        }
        
        .gallery-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
        }
        
        .gallery-item img {
            display: block;
            width: 100%;
            height: 250px;
            object-fit: cover;
            opacity: 0;
            transition: transform 0.3s ease, opacity 0.4s ease;
        }
        
        .gallery-item img.loaded {
            opacity: 1;
        }
        
        .gallery-item:hover img {
            transform: scale(1.05);
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 1rem;
        }
        
        .section-title h2 {
            font-size: 2.5rem;
            color: #1a1a2e;
            margin-bottom: 0.5rem;
        }
        
        .section-title p {
            font-size: 1.1rem;
            color: #666;
            max-width: 600px;
            margin: 0 auto;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <a href="/">
                    <img src="/images/logo.png" alt="Innovate Logo">
                </a>
            </div>
            <ul class="nav-links">
                <li><a href="/">CONFERENCE</a></li>
                <li><a href="/about">ABOUT</a></li>
                <li><a href="/partners">PAST PARTNERS</a></li>
                <li><a href="/gallery" class="active">GALLERY</a></li>
                <!-- <li><a href="/challenge">CHALLENGE</a></li> -->
            </ul>
            <a href="/register" class="register-btn">REGISTER</a>
        </div>
    </nav>

    <!-- Gallery Hero Section -->
    <section class="gallery-hero">
        <div class="container">
            <h1>Event Gallery</h1>
            <p>Relive the amazing moments from past Innovate@Berkeley events</p>
        </div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery-section">
        <div class="container">
            <h2 class="gallery-title">Event Gallery</h2>
            <div class="gallery-grid" id="gallery-grid">
                <!-- First few photos load right away (visible on screen); the rest load as you scroll -->
                <div class="gallery-item" data-category="2023">
                    <img src="/images/innovate-62.jpg" alt="Innovate Event 2023" decoding="async" fetchpriority="high">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/innovate-66.jpg" alt="Innovate Event 2023" decoding="async" fetchpriority="high">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/innovate-89.jpg" alt="Innovate Event 2023" decoding="async" fetchpriority="high">
                </div>
                <div class="gallery-item" data-category="2022">
                    <img src="/images/innovate-127.jpg" alt="Innovate Event 2022" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2022">
                    <img src="/images/innovate-154.jpg" alt="Innovate Event 2022" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2022">
                    <img src="/images/innovate-212.jpg" alt="Innovate Event 2022" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2021">
                    <img src="/images/innovate-20.jpg" alt="Innovate Event 2021" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2021">
                    <img src="/images/Innovate-28.jpg" alt="Innovate Event 2021" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/innovate-81.jpg" alt="Berkeley Campus" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/INNOVATE-143.jpg" alt="Innovate Event 2023" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/innovate-43.jpg" alt="Innovate Event 2023" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/innovate-48.jpg" alt="Innovate Event 2023" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/INNOVATE-78.jpg" alt="Innovate Event 2023" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/INNOVATE-91.jpg" alt="Innovate Event 2023" loading="lazy" decoding="async">
                </div>
                <div class="gallery-item" data-category="2023">
                    <img src="/images/Carousel1.jpeg" alt="Innovate Event 2023" loading="lazy" decoding="async">
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-about">
                <img src="/images/logo.png" alt="Innovate Logo" class="footer-logo">
                <h4>ABOUT</h4>
                <p>Innovate@Berkeley is the largest startup expo at Berkeley and is the ultimate hub for entrepreneurship. Speakers, startup booths, and challenges make for an exciting program of events that involves the entire startup community.</p>
            </div>
            <div class="footer-social">
                <h4>Follow Us</h4>
                <ul class="social-links">
                    <li><a href="mailto:Innovate2025@berkeley.edu">Innovate2025@berkeley.edu</a></li>
                    <li><a href="https://facebook.com/berkeleyinnovate">@berkeleyinnovate</a></li>
                    <li><a href="https://instagram.com/berkeleyinnovate">@berkeleyinnovate</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 Innovate at Berkeley. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add scroll effect to navbar
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 100) {
                navbar.style.background = 'rgba(26, 26, 46, 0.8)';
            } else {
                navbar.style.background = 'rgba(26, 26, 46, 0.3)';
            }
        });

        // Fade each photo in as soon as it loads (no waiting for the whole gallery)
        document.querySelectorAll('.gallery-item img').forEach(img => {
            const show = () => img.classList.add('loaded');
            if (img.complete && img.naturalHeight !== 0) {
                show();
            } else {
                img.addEventListener('load', show, { once: true });
                img.addEventListener('error', show, { once: true });
            }
        });
    </script>
</body>
</html>