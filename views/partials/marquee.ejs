<%#
  Logo marquee. Items render from data/partners.json.
  Items are rendered twice so the CSS loop has no seam; the second copy is aria-hidden.
-%>
<%
  // One row: past partners first, then this year's startups
  const items = [
    ...partners.filter(p => p.marquee && p.year !== 2027),
    ...partners.filter(p => p.marquee && p.kind === 'startup' && p.year === 2027),
  ];
-%>
<section class="marquee-section" aria-labelledby="marquee-label">
    <p class="marquee-label" id="marquee-label">Partners and startups</p>
    <div class="marquee" data-speed="50" tabindex="0" role="region" aria-labelledby="marquee-label">
        <ul class="marquee__track">
<% [false, true].forEach(hidden => { items.forEach(item => { -%>
            <li<%- hidden ? ' aria-hidden="true"' : '' %>><%- include('logo', { item, hidden }) %></li>
<% }) }) -%>
        </ul>
    </div>
</section>
<script src="/js/marquee.js"></script>
