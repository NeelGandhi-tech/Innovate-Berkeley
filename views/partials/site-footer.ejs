<footer class="site-footer">
    <div class="wrap grid">
        <div class="site-footer__brand">
            <img src="/images/logo.png" alt="Innovate @ Berkeley" width="855" height="210">
            <p>Organized by <a href="<%= site.organizerUrl %>">Alpha Epsilon Zeta</a>.</p>
        </div>
        <ul class="site-footer__links">
            <li><a href="mailto:<%= site.contactEmail %>"><%= site.contactEmail %></a></li>
            <li><a href="<%= site.instagram %>">Instagram</a></li>
            <li><a href="<%= site.facebook %>">Facebook</a></li>
        </ul>
        <ul class="site-footer__links">
            <li><a href="/">About</a></li>
            <li><a href="/partners">Past partners</a></li>
            <li><a href="/gallery">Gallery</a></li>
            <li><a href="<%= site.registerUrl %>">Register</a></li>
        </ul>
        <p class="site-footer__legal">&copy; <%= year %> Innovate at Berkeley. All rights reserved.</p>
    </div>
</footer>
