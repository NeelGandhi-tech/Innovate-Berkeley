<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: '', path: '/', description: `Innovate@Berkeley is the largest startup expo at Berkeley. Speakers, startup booths and the whole startup community. ${site.eventDate}, ${site.eventPlace}.` }) %>
</head>
<body>
    <%- include('partials/site-header', { current: 'home' }) %>

    <main id="main">
        <!-- Hero -->
        <section class="hero">
            <div class="wrap grid">
                <div class="hero__text">
                    <p class="kicker">Berkeley's largest entrepreneurship expo</p>
                    <h1 class="hero__title">Innovate @&nbsp;Berkeley</h1>
                    <p class="hero__when"><time datetime="2027-02-11"><%= site.eventDate %></time> · <%= site.eventPlace %></p>
                    <p class="hero__lede">Startup disruption in Berkeley's front yard, powered by AEZ.</p>
                    <div class="hero__actions">
                        <a class="button button--primary button--large" href="<%= site.registerUrl %>">Register</a>
                        <p class="hero__note">Free for Berkeley students. $25 for all other attendees.</p>
                    </div>
                </div>
                <figure class="hero__photo">
                    <img src="/images/photos/fa25-254-960.jpg"
                         srcset="/images/photos/fa25-254-960.jpg 960w, /images/photos/fa25-254-1600.jpg 1600w"
                         sizes="(min-width: 900px) 58vw, 100vw"
                         width="1600" height="1066" fetchpriority="high" decoding="async"
                         alt="A panel of three speakers on stage at Innovate Fall 2025, seen from behind the seated audience">
                    <figcaption>Panel, Fall 2025</figcaption>
                </figure>
            </div>
        </section>

        <!-- Partner marquee -->
        <%- include('partials/marquee') %>

        <!-- Past speakers -->
        <section class="section speakers" aria-labelledby="speakers-title">
            <div class="wrap grid">
                <header class="section__head">
                    <p class="kicker">Who has spoken</p>
                    <h2 id="speakers-title">Past speakers</h2>
                    <a class="text-link" href="/partners">All past partners</a>
                </header>
                <ol class="speaker-list">
<% speakers.forEach(s => { -%>
                    <li><span class="speaker-list__name"><%= s.name %></span> <span class="speaker-list__firm"><%= s.firm %></span></li>
<% }) -%>
                </ol>
            </div>
        </section>

        <!-- What to expect -->
        <section class="section expect" aria-labelledby="expect-title">
            <div class="wrap grid">
                <header class="section__head">
                    <p class="kicker">The day</p>
                    <h2 id="expect-title">What to expect</h2>
                    <p class="section__body">Innovate@Berkeley is the largest startup expo at Berkeley and the hub for entrepreneurship. Speakers, startup booths, and challenges make for a program of events that involves the entire startup community.</p>
                </header>
                <div class="expect__photos">
                    <figure class="expect__photo expect__photo--wide">
                        <img src="/images/photos/fa25-110-960.jpg"
                             srcset="/images/photos/fa25-110-480.jpg 480w, /images/photos/fa25-110-960.jpg 960w"
                             sizes="(min-width: 900px) 58vw, 100vw"
                             width="960" height="640" loading="lazy" decoding="async"
                             alt="Five people standing together at the Typeface booth at Innovate Fall 2025">
                        <figcaption>Startup booths</figcaption>
                    </figure>
                    <figure class="expect__photo">
                        <img src="/images/photos/fa25-145-480.jpg"
                             srcset="/images/photos/fa25-145-480.jpg 480w, /images/photos/fa25-145-960.jpg 960w"
                             sizes="(min-width: 900px) 29vw, 50vw"
                             width="960" height="640" loading="lazy" decoding="async"
                             alt="Three speakers seated on stools on stage at Innovate Fall 2025">
                        <figcaption>Speakers</figcaption>
                    </figure>
                    <figure class="expect__photo">
                        <img src="/images/photos/fa25-125-480.jpg"
                             srcset="/images/photos/fa25-125-480.jpg 480w, /images/photos/fa25-125-960.jpg 960w"
                             sizes="(min-width: 900px) 29vw, 50vw"
                             width="960" height="640" loading="lazy" decoding="async"
                             alt="Five attendees posing together in the hallway outside the event hall at Innovate Fall 2025">
                        <figcaption>The community</figcaption>
                    </figure>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="section faq" aria-labelledby="faq-title">
            <div class="wrap grid">
                <header class="section__head">
                    <p class="kicker">Before you come</p>
                    <h2 id="faq-title">Questions</h2>
                </header>
                <div class="faq__list">
                    <details>
                        <summary>Who can attend?</summary>
                        <p>Everyone!</p>
                    </details>
                    <details>
                        <summary>How much does it cost?</summary>
                        <p>It's free for Berkeley students! For all other attendees, the registration fee is $25.</p>
                    </details>
                    <details>
                        <summary>Do I have to stay the whole time?</summary>
                        <p>Feel free to come in and out as your schedule allows. However, we recommend coming by 4:30 PM to check in.</p>
                    </details>
                    <details>
                        <summary>What do I do if I have more questions?</summary>
                        <p>Send us an email at <a href="mailto:Innovate2025@berkeley.edu">Innovate2025@berkeley.edu</a>.</p>
                    </details>
                </div>
            </div>
        </section>

        <!-- Photo between sections -->
        <figure class="photo-band">
            <img src="/images/photos/fa25-272-960.jpg"
                 srcset="/images/photos/fa25-272-480.jpg 480w, /images/photos/fa25-272-960.jpg 960w"
                 sizes="100vw" width="960" height="640" loading="lazy" decoding="async"
                 alt="A large group photo in the event hall at Innovate Fall 2025, with the event slide on the screen behind them">
            <figcaption class="wrap">Innovate, Fall 2025</figcaption>
        </figure>

        <!-- Contact -->
        <section class="section contact" id="contact" aria-labelledby="contact-title">
            <div class="wrap grid">
                <header class="section__head">
                    <p class="kicker">Sponsors, attendees, anyone</p>
                    <h2 id="contact-title">Contact us</h2>
                </header>
                <form class="contact-form" action="https://formspree.io/f/mqayplry" method="POST">
                    <fieldset class="field field--choice">
                        <legend>I am interested in</legend>
                        <label><input type="radio" name="interest-type" value="sponsor" checked> Company sponsorship</label>
                        <label><input type="radio" name="interest-type" value="attendee"> Attending the event</label>
                        <label><input type="radio" name="interest-type" value="other"> Other questions</label>
                    </fieldset>
                    <div class="field">
                        <label for="name">Name <span class="field__req">(required)</span></label>
                        <input type="text" id="name" name="name" autocomplete="name" required>
                    </div>
                    <div class="field">
                        <label for="email">Email <span class="field__req">(required)</span></label>
                        <input type="email" id="email" name="email" autocomplete="email" required>
                    </div>
                    <div class="field">
                        <label for="phone">Phone <span class="field__req">(optional)</span></label>
                        <input type="tel" id="phone" name="phone" autocomplete="tel">
                    </div>
                    <div class="field field--full">
                        <label for="message">Message <span class="field__req">(required)</span></label>
                        <textarea id="message" name="message" rows="6" required></textarea>
                    </div>
                    <div class="field--full">
                        <button type="submit" class="button button--primary submit-btn">Send message</button>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <%- include('partials/site-footer') %>

    <script src="/js/form.js"></script>
</body>
</html>
