    <!-- Contact Section -->
    <section id="contact" class="contact-section">
        <div class="container">
            <h2>Contact Us</h2>
            <div class="contact-content">
                <div class="contact-form-container">
                    <form action="https://formspree.io/f/mqayplry" method="POST" class="contact-form">
                        <div class="form-group">
                            <label>I am interested in:</label>
                            <div class="button-group">
                                <button type="button" class="interest-btn" data-value="sponsor">Company Sponsorship</button>
                                <button type="button" class="interest-btn" data-value="attendee">Attending the Event</button>
                                <button type="button" class="interest-btn" data-value="other">Other Questions?</button>
                            </div>
                            <input type="hidden" id="interest-type" name="interest-type" value="sponsor" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="name">Name *</label>
                            <input type="text" id="name" name="name" required>
                        </div>
                        
                        
                        <div class="form-group">
                            <label for="email">Email *</label>
                            <input type="email" id="email" name="email" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone">
                        </div>
                        
                        <div class="form-group">
                            <label for="message">Message *</label>
