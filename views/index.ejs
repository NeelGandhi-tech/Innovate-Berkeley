    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add scroll effect to navbar
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 100) {
                navbar.style.background = 'rgba(26, 26, 46, 0.8)';
            } else {
                navbar.style.background = 'rgba(26, 26, 46, 0.3)';
            }
        });

        // Very simple mobile menu
        document.addEventListener('DOMContentLoaded', function() {
            const mobileToggle = document.getElementById('mobile-menu-toggle');
            const navLinks = document.getElementById('nav-links');
            
            if (mobileToggle && navLinks) {
                mobileToggle.onclick = function() {
                    if (navLinks.style.display === 'block') {
                        navLinks.style.display = 'none';
                    } else {
                        navLinks.style.display = 'block';
                    }
                };
            }
        });

        // Trigger animations on page load
        window.addEventListener('load', () => {
            const elements = document.querySelectorAll('.fade-in');
            elements.forEach((el, index) => {
                setTimeout(() => {
                    el.style.animationPlayState = 'running';
                }, index * 100);
            });
        });

        // Intersection Observer for scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe cards for animation
        document.querySelectorAll('.logistics-card, .schedule-item').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'all 0.6s ease';
            observer.observe(el);
        });

        // Animate schedule items on scroll
        const scheduleObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('animate');
                    }, index * 150);
                }
            });
        }, { threshold: 0.2, rootMargin: '0px 0px -50px 0px' });

        // Initialize schedule items for animation
        document.querySelectorAll('.schedule-item').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(30px)';
            scheduleObserver.observe(el);
        });

        // Animate speaker cards
        const speakerObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('animate');
                    }, index * 100);
                }
            });
        }, { threshold: 0.2, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.speaker-card').forEach(el => {
            speakerObserver.observe(el);
        });


        // Typing animation
        const texts = [
            "Together we can innovate.",
            "Build the future.",
            "Start something amazing.",
            "Change the world.",
            "Create tomorrow."
        ];
        
        let textIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        const typingElement = document.getElementById('typing-text');
        
        function typeText() {
            const currentText = texts[textIndex];
            
            if (isDeleting) {
                typingElement.textContent = currentText.substring(0, charIndex - 1);
                charIndex--;
            } else {
                typingElement.textContent = currentText.substring(0, charIndex + 1);
                charIndex++;
            }
            
            let typeSpeed = isDeleting ? 50 : 100;
            
            if (!isDeleting && charIndex === currentText.length) {
                typeSpeed = 2000; // Pause at end
                isDeleting = true;
            } else if (isDeleting && charIndex === 0) {
                isDeleting = false;
                textIndex = (textIndex + 1) % texts.length;
                typeSpeed = 500; // Pause before next text
            }
            
            setTimeout(typeText, typeSpeed);
        }
        
        // Start typing animation after page load
        setTimeout(typeText, 1000);

        // Optimized gallery loading performance with lazy loading
        const galleryImages = document.querySelectorAll('.gallery-item img');
        
        // Use Intersection Observer for lazy loading with better performance
        const imageObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    
                    // Add loading class for better UX
                    img.classList.add('loading');
                    
                    if (img.complete && img.naturalHeight !== 0) {
                        // Image already loaded
                        img.classList.remove('loading');
                        img.classList.add('loaded');
                    } else {
                        // Wait for image to load
                        img.addEventListener('load', () => {
                            img.classList.remove('loading');
                            img.classList.add('loaded');
                        }, { once: true });
                        
                        img.addEventListener('error', () => {
                            img.classList.remove('loading');
                            img.classList.add('error');
                        }, { once: true });
                    }
                    
                    imageObserver.unobserve(img);
                }
            });
        }, { 
            rootMargin: '100px 0px',
            threshold: 0.01 
        });
        
        // Only observe images that are not already loaded
        galleryImages.forEach(img => {
            if (!img.complete || img.naturalHeight === 0) {
                imageObserver.observe(img);
            } else {
                img.classList.add('loaded');
            }
        });

        // Enhanced smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Continuous scrolling improvements
        let isScrolling = false;
        window.addEventListener('scroll', () => {
            if (!isScrolling) {
                window.requestAnimationFrame(() => {
                    // Add any scroll-based animations here
                    isScrolling = false;
                });
                isScrolling = true;
            }
        });
    </script>
    
    <!-- Form handling script -->
    <script src="/js/form.js?v=<%= Date.now() %>"></script>
</body>
</html>
